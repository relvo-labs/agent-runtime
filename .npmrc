# Supply-chain posture: see docs/adr/ADR-0013-supply-chain-policy.md
# and .agents/skills/pnpm-supply-chain/SKILL.md.

# Lockfile is authoritative. CI installs must fail rather than mutate it.
prefer-frozen-lockfile=true

# Never silently accept a resolution that does not match the lockfile integrity.
verify-deps-before-run=true

# Peer dependency violations are design defects, not warnings to scroll past.
strict-peer-dependencies=true
auto-install-peers=false

# Dependency lifecycle scripts stay OFF by default. Allow-listing happens
# per-package in pnpm-workspace.yaml `onlyBuiltDependencies`, never globally.
enable-pre-post-scripts=false

# Do not let a transitive dependency be resolved from an unexpected registry.
registry=https://registry.npmjs.org/

# Reproducibility: reject `latest` drift for the package manager itself.
manage-package-manager-versions=true
