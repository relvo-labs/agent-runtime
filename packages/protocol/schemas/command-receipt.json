{
  "$defs": {
    "agent-error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/agent-error-code"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "providerCode": {
          "maxLength": 200,
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "agent-error-code": {
      "enum": [
        "invalid_request",
        "unknown_session",
        "unknown_turn",
        "unknown_run",
        "unknown_interaction",
        "illegal_state_transition",
        "command_id_conflict",
        "session_closed",
        "run_already_terminal",
        "interaction_already_settled",
        "interaction_expired",
        "capability_unsupported",
        "workspace_unavailable",
        "workspace_ownership_violation",
        "provider_not_registered",
        "provider_rejected",
        "provider_unavailable",
        "provider_contract_violation",
        "store_conflict",
        "store_unavailable",
        "subscriber_overflow",
        "cursor_out_of_range",
        "internal"
      ],
      "type": "string"
    },
    "command-id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "command-result": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "sessionId": {
              "$ref": "#/$defs/session-id"
            },
            "type": {
              "const": "session_opened",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sessionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "runId": {
              "$ref": "#/$defs/run-id"
            },
            "sessionId": {
              "$ref": "#/$defs/session-id"
            },
            "turnId": {
              "$ref": "#/$defs/turn-id"
            },
            "type": {
              "const": "turn_accepted",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sessionId",
            "turnId",
            "runId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "delivered": {
              "type": "boolean"
            },
            "runId": {
              "$ref": "#/$defs/run-id"
            },
            "sessionId": {
              "$ref": "#/$defs/session-id"
            },
            "type": {
              "const": "run_interrupt_requested",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sessionId",
            "runId",
            "delivered"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "interactionId": {
              "$ref": "#/$defs/interaction-id"
            },
            "sessionId": {
              "$ref": "#/$defs/session-id"
            },
            "type": {
              "const": "interaction_settled",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sessionId",
            "interactionId"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "interruptedActiveRun": {
              "type": "boolean"
            },
            "sessionId": {
              "$ref": "#/$defs/session-id"
            },
            "type": {
              "const": "session_closed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "sessionId",
            "interruptedActiveRun"
          ],
          "type": "object"
        }
      ]
    },
    "interaction-id": {
      "pattern": "^int_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "json-value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/json-value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "run-id": {
      "pattern": "^run_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "session-id": {
      "pattern": "^ses_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "turn-id": {
      "pattern": "^trn_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.relvo.dev/agent-runtime/0.4/command-receipt.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "else": {
    "not": {
      "required": [
        "error"
      ]
    },
    "required": [
      "result"
    ]
  },
  "if": {
    "properties": {
      "disposition": {
        "const": "rejected"
      }
    },
    "required": [
      "disposition"
    ]
  },
  "properties": {
    "acceptedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "commandId": {
      "$ref": "#/$defs/command-id"
    },
    "commandType": {
      "enum": [
        "open_session",
        "submit_turn",
        "interrupt_run",
        "respond_to_interaction",
        "close_session"
      ],
      "type": "string"
    },
    "disposition": {
      "enum": [
        "applied",
        "duplicate",
        "rejected"
      ],
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/agent-error"
    },
    "result": {
      "$ref": "#/$defs/command-result"
    },
    "sequence": {
      "$ref": "#/$defs/sequence"
    }
  },
  "required": [
    "commandId",
    "commandType",
    "disposition",
    "acceptedAt"
  ],
  "then": {
    "not": {
      "required": [
        "result"
      ]
    },
    "required": [
      "error"
    ]
  },
  "title": "command-receipt",
  "type": "object",
  "x-wire-version": "0.4"
}
