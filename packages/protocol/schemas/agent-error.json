{
  "$defs": {
    "agent-error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/agent-error-code"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "providerCode": {
          "maxLength": 200,
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "agent-error-code": {
      "enum": [
        "invalid_request",
        "unknown_session",
        "unknown_turn",
        "unknown_run",
        "unknown_interaction",
        "illegal_state_transition",
        "command_id_conflict",
        "session_closed",
        "run_already_terminal",
        "interaction_already_settled",
        "interaction_expired",
        "capability_unsupported",
        "workspace_unavailable",
        "workspace_ownership_violation",
        "provider_not_registered",
        "provider_rejected",
        "provider_unavailable",
        "provider_contract_violation",
        "store_conflict",
        "store_unavailable",
        "subscriber_overflow",
        "cursor_out_of_range",
        "internal"
      ],
      "type": "string"
    },
    "json-value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/json-value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://schemas.relvo.dev/agent-runtime/0.4/agent-error.json",
  "$ref": "#/$defs/agent-error",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-error",
  "x-wire-version": "0.4"
}
