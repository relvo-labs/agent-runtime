{
  "$defs": {
    "json-value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/json-value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "turn-input": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/turn-input-part"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "parts"
      ],
      "type": "object"
    },
    "turn-input-part": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "maxLength": 1000000,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$",
              "type": "string"
            },
            "type": {
              "const": "file_ref",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://schemas.relvo.dev/agent-runtime/0.4/turn-input.json",
  "$ref": "#/$defs/turn-input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "turn-input",
  "x-wire-version": "0.4"
}
