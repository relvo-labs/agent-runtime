{
  "$defs": {
    "timestamp": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "workspace-lease-descriptor": {
      "additionalProperties": false,
      "properties": {
        "acquiredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "leaseId": {
          "$ref": "#/$defs/workspace-lease-id"
        },
        "ownership": {
          "$ref": "#/$defs/workspace-ownership"
        },
        "released": {
          "default": false,
          "type": "boolean"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "leaseId",
        "ownership",
        "root",
        "acquiredAt",
        "released"
      ],
      "type": "object"
    },
    "workspace-lease-id": {
      "pattern": "^wsl_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "workspace-ownership": {
      "enum": [
        "borrowed",
        "managed"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.relvo.dev/agent-runtime/0.4/workspace-lease-descriptor.json",
  "$ref": "#/$defs/workspace-lease-descriptor",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workspace-lease-descriptor",
  "x-wire-version": "0.4"
}
