{
  "$defs": {
    "agent-error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/agent-error-code"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "providerCode": {
          "maxLength": 200,
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "agent-error-code": {
      "enum": [
        "invalid_request",
        "unknown_session",
        "unknown_turn",
        "unknown_run",
        "unknown_interaction",
        "illegal_state_transition",
        "command_id_conflict",
        "session_closed",
        "run_already_terminal",
        "interaction_already_settled",
        "interaction_expired",
        "capability_unsupported",
        "workspace_unavailable",
        "workspace_ownership_violation",
        "provider_not_registered",
        "provider_rejected",
        "provider_unavailable",
        "provider_contract_violation",
        "store_conflict",
        "store_unavailable",
        "subscriber_overflow",
        "cursor_out_of_range",
        "internal"
      ],
      "type": "string"
    },
    "json-value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/json-value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "session-id": {
      "pattern": "^ses_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "session-state": {
      "enum": [
        "opening",
        "ready",
        "closing",
        "closed",
        "failed"
      ],
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "turn-id": {
      "pattern": "^trn_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "workspace-lease-descriptor": {
      "additionalProperties": false,
      "properties": {
        "acquiredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "leaseId": {
          "$ref": "#/$defs/workspace-lease-id"
        },
        "ownership": {
          "$ref": "#/$defs/workspace-ownership"
        },
        "released": {
          "default": false,
          "type": "boolean"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "leaseId",
        "ownership",
        "root",
        "acquiredAt"
      ],
      "type": "object"
    },
    "workspace-lease-id": {
      "pattern": "^wsl_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "workspace-ownership": {
      "enum": [
        "borrowed",
        "managed"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.relvo.dev/agent-runtime/0.4/agent-session.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "error": {
      "$ref": "#/$defs/agent-error"
    },
    "providerId": {
      "minLength": 1,
      "type": "string"
    },
    "sequence": {
      "$ref": "#/$defs/sequence"
    },
    "sessionId": {
      "$ref": "#/$defs/session-id"
    },
    "state": {
      "$ref": "#/$defs/session-state"
    },
    "turnIds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/turn-id"
      },
      "type": "array"
    },
    "wireVersion": {
      "const": "0.4",
      "type": "string"
    },
    "workspace": {
      "$ref": "#/$defs/workspace-lease-descriptor"
    }
  },
  "required": [
    "sessionId",
    "state",
    "providerId",
    "wireVersion",
    "workspace",
    "createdAt",
    "sequence"
  ],
  "title": "agent-session",
  "type": "object",
  "x-wire-version": "0.4"
}
