{
  "$defs": {
    "agent-error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/agent-error-code"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "providerCode": {
          "maxLength": 200,
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "agent-error-code": {
      "enum": [
        "invalid_request",
        "unknown_session",
        "unknown_turn",
        "unknown_run",
        "unknown_interaction",
        "illegal_state_transition",
        "command_id_conflict",
        "session_closed",
        "run_already_terminal",
        "interaction_already_settled",
        "interaction_expired",
        "capability_unsupported",
        "workspace_unavailable",
        "workspace_ownership_violation",
        "provider_not_registered",
        "provider_rejected",
        "provider_unavailable",
        "provider_contract_violation",
        "store_conflict",
        "store_unavailable",
        "subscriber_overflow",
        "cursor_out_of_range",
        "internal"
      ],
      "type": "string"
    },
    "approval-mode": {
      "enum": [
        "once",
        "session",
        "persistent"
      ],
      "type": "string"
    },
    "approval-request": {
      "additionalProperties": false,
      "properties": {
        "allowedModes": {
          "items": {
            "$ref": "#/$defs/approval-mode"
          },
          "minItems": 1,
          "type": "array"
        },
        "kind": {
          "const": "approval",
          "type": "string"
        },
        "riskHint": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/approval-subject"
        }
      },
      "required": [
        "kind",
        "subject",
        "allowedModes"
      ],
      "type": "object"
    },
    "approval-response": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "denied"
          ],
          "type": "string"
        },
        "kind": {
          "const": "approval",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/approval-mode"
        },
        "reason": {
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "decision"
      ],
      "type": "object"
    },
    "approval-subject": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "command",
            "file_write",
            "file_delete",
            "network",
            "tool",
            "other"
          ],
          "type": "string"
        },
        "detail": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "category",
        "summary"
      ],
      "type": "object"
    },
    "event-id": {
      "pattern": "^evt_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "event-payload": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "providerId": {
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "session.opened",
              "type": "string"
            },
            "workspace": {
              "$ref": "#/$defs/workspace-lease-descriptor"
            }
          },
          "required": [
            "type",
            "providerId",
            "workspace"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/session-state"
            },
            "to": {
              "$ref": "#/$defs/session-state"
            },
            "type": {
              "const": "session.state_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": {
              "$ref": "#/$defs/agent-error"
            },
            "reason": {
              "enum": [
                "requested",
                "failed"
              ],
              "type": "string"
            },
            "type": {
              "const": "session.closed",
              "type": "string"
            },
            "workspaceRelease": {
              "$ref": "#/$defs/workspace-release-report"
            }
          },
          "required": [
            "type",
            "reason",
            "workspaceRelease"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/$defs/turn-input"
            },
            "turnId": {
              "$ref": "#/$defs/turn-id"
            },
            "type": {
              "const": "turn.started",
              "type": "string"
            }
          },
          "required": [
            "type",
            "turnId",
            "input"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/turn-state"
            },
            "to": {
              "$ref": "#/$defs/turn-state"
            },
            "turnId": {
              "$ref": "#/$defs/turn-id"
            },
            "type": {
              "const": "turn.state_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "turnId",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": {
              "$ref": "#/$defs/agent-error"
            },
            "output": {
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/turn-state"
            },
            "turnId": {
              "$ref": "#/$defs/turn-id"
            },
            "type": {
              "const": "turn.settled",
              "type": "string"
            }
          },
          "required": [
            "type",
            "turnId",
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempt": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "turnId": {
              "$ref": "#/$defs/turn-id"
            },
            "type": {
              "const": "run.started",
              "type": "string"
            }
          },
          "required": [
            "type",
            "turnId",
            "attempt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/run-state"
            },
            "to": {
              "$ref": "#/$defs/run-state"
            },
            "type": {
              "const": "run.state_changed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "from",
            "to"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "maxLength": 100000,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "run.message_delta",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "detail": {
              "additionalProperties": {
                "$ref": "#/$defs/json-value"
              },
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "phase": {
              "enum": [
                "invoked",
                "succeeded",
                "failed"
              ],
              "type": "string"
            },
            "toolName": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "run.tool_activity",
              "type": "string"
            }
          },
          "required": [
            "type",
            "toolName",
            "phase"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "run.usage",
              "type": "string"
            },
            "usage": {
              "$ref": "#/$defs/usage"
            }
          },
          "required": [
            "type",
            "usage"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "termination": {
              "$ref": "#/$defs/run-termination"
            },
            "turnId": {
              "$ref": "#/$defs/turn-id"
            },
            "type": {
              "const": "run.finished",
              "type": "string"
            }
          },
          "required": [
            "type",
            "turnId",
            "termination"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "expiresAt": {
              "$ref": "#/$defs/timestamp"
            },
            "interactionId": {
              "$ref": "#/$defs/interaction-id"
            },
            "request": {
              "$ref": "#/$defs/interaction-request"
            },
            "turnId": {
              "$ref": "#/$defs/turn-id"
            },
            "type": {
              "const": "interaction.requested",
              "type": "string"
            }
          },
          "required": [
            "type",
            "interactionId",
            "turnId",
            "request"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "interactionId": {
              "$ref": "#/$defs/interaction-id"
            },
            "settlement": {
              "$ref": "#/$defs/interaction-settlement"
            },
            "turnId": {
              "$ref": "#/$defs/turn-id"
            },
            "type": {
              "const": "interaction.settled",
              "type": "string"
            }
          },
          "required": [
            "type",
            "interactionId",
            "turnId",
            "settlement"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "detail": {
              "additionalProperties": {
                "$ref": "#/$defs/json-value"
              },
              "propertyNames": {
                "type": "string"
              },
              "type": "object"
            },
            "level": {
              "enum": [
                "debug",
                "info",
                "warning"
              ],
              "type": "string"
            },
            "message": {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "diagnostic",
              "type": "string"
            }
          },
          "required": [
            "type",
            "level",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "interaction-id": {
      "pattern": "^int_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "interaction-request": {
      "oneOf": [
        {
          "$ref": "#/$defs/question-request"
        },
        {
          "$ref": "#/$defs/approval-request"
        }
      ]
    },
    "interaction-response": {
      "oneOf": [
        {
          "$ref": "#/$defs/question-response"
        },
        {
          "$ref": "#/$defs/approval-response"
        }
      ]
    },
    "interaction-settlement": {
      "additionalProperties": false,
      "else": {
        "not": {
          "required": [
            "response"
          ]
        }
      },
      "if": {
        "properties": {
          "outcome": {
            "const": "responded"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "properties": {
        "error": {
          "$ref": "#/$defs/agent-error"
        },
        "outcome": {
          "$ref": "#/$defs/settlement-outcome"
        },
        "response": {
          "$ref": "#/$defs/interaction-response"
        },
        "settledAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "outcome",
        "settledAt"
      ],
      "then": {
        "required": [
          "response"
        ]
      },
      "type": "object"
    },
    "json-value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/json-value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "question-choice": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2000,
          "type": "string"
        },
        "label": {
          "maxLength": 400,
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "question-request": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/question-choice"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "kind": {
          "const": "question",
          "type": "string"
        },
        "multiSelect": {
          "default": false,
          "type": "boolean"
        },
        "placeholder": {
          "maxLength": 400,
          "type": "string"
        },
        "prompt": {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "prompt"
      ],
      "type": "object"
    },
    "question-response": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "maxLength": 16000,
              "type": "string"
            },
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            }
          ]
        },
        "kind": {
          "const": "question",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "answer"
      ],
      "type": "object"
    },
    "run-id": {
      "pattern": "^run_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "run-state": {
      "enum": [
        "queued",
        "starting",
        "running",
        "awaiting_interaction",
        "interrupting",
        "succeeded",
        "failed",
        "interrupted"
      ],
      "type": "string"
    },
    "run-termination": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "error": {
          "$ref": "#/$defs/agent-error"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "interrupted"
          ],
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "at"
      ],
      "type": "object"
    },
    "sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "session-id": {
      "pattern": "^ses_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "session-state": {
      "enum": [
        "opening",
        "ready",
        "closing",
        "closed",
        "failed"
      ],
      "type": "string"
    },
    "settlement-outcome": {
      "enum": [
        "responded",
        "cancelled",
        "expired",
        "withdrawn"
      ],
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "turn-id": {
      "pattern": "^trn_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "turn-input": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/turn-input-part"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "parts"
      ],
      "type": "object"
    },
    "turn-input-part": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "maxLength": 1000000,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$",
              "type": "string"
            },
            "type": {
              "const": "file_ref",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "turn-state": {
      "enum": [
        "accepted",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "inputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "totalTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "workspace-lease-descriptor": {
      "additionalProperties": false,
      "properties": {
        "acquiredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "leaseId": {
          "$ref": "#/$defs/workspace-lease-id"
        },
        "ownership": {
          "$ref": "#/$defs/workspace-ownership"
        },
        "released": {
          "default": false,
          "type": "boolean"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "leaseId",
        "ownership",
        "root",
        "acquiredAt"
      ],
      "type": "object"
    },
    "workspace-lease-id": {
      "pattern": "^wsl_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "workspace-ownership": {
      "enum": [
        "borrowed",
        "managed"
      ],
      "type": "string"
    },
    "workspace-release-report": {
      "additionalProperties": false,
      "properties": {
        "alreadyReleased": {
          "default": false,
          "type": "boolean"
        },
        "destructiveOperations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "leaseId": {
          "$ref": "#/$defs/workspace-lease-id"
        },
        "ownership": {
          "$ref": "#/$defs/workspace-ownership"
        },
        "releasedAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "leaseId",
        "ownership",
        "releasedAt"
      ],
      "type": "object"
    }
  },
  "$id": "https://schemas.relvo.dev/agent-runtime/0.4/event-page.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "eventId": {
            "$ref": "#/$defs/event-id"
          },
          "occurredAt": {
            "$ref": "#/$defs/timestamp"
          },
          "payload": {
            "$ref": "#/$defs/event-payload"
          },
          "runId": {
            "$ref": "#/$defs/run-id"
          },
          "sequence": {
            "$ref": "#/$defs/sequence"
          },
          "sessionId": {
            "$ref": "#/$defs/session-id"
          },
          "wireVersion": {
            "const": "0.4",
            "type": "string"
          }
        },
        "required": [
          "eventId",
          "sessionId",
          "sequence",
          "occurredAt",
          "wireVersion",
          "payload"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hasMore": {
      "type": "boolean"
    },
    "nextSequence": {
      "$ref": "#/$defs/sequence"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "events",
    "nextSequence",
    "revision",
    "hasMore"
  ],
  "title": "event-page",
  "type": "object",
  "x-wire-version": "0.4"
}
