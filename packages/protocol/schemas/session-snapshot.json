{
  "$defs": {
    "agent-error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/agent-error-code"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "providerCode": {
          "maxLength": 200,
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "agent-error-code": {
      "enum": [
        "invalid_request",
        "unknown_session",
        "unknown_turn",
        "unknown_run",
        "unknown_interaction",
        "illegal_state_transition",
        "command_id_conflict",
        "session_closed",
        "run_already_terminal",
        "interaction_already_settled",
        "interaction_expired",
        "capability_unsupported",
        "workspace_unavailable",
        "workspace_ownership_violation",
        "provider_not_registered",
        "provider_rejected",
        "provider_unavailable",
        "provider_contract_violation",
        "store_conflict",
        "store_unavailable",
        "subscriber_overflow",
        "cursor_out_of_range",
        "internal"
      ],
      "type": "string"
    },
    "approval-mode": {
      "enum": [
        "once",
        "session",
        "persistent"
      ],
      "type": "string"
    },
    "approval-request": {
      "additionalProperties": false,
      "properties": {
        "allowedModes": {
          "items": {
            "$ref": "#/$defs/approval-mode"
          },
          "minItems": 1,
          "type": "array"
        },
        "kind": {
          "const": "approval",
          "type": "string"
        },
        "riskHint": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/approval-subject"
        }
      },
      "required": [
        "kind",
        "subject",
        "allowedModes",
        "riskHint"
      ],
      "type": "object"
    },
    "approval-response": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "denied"
          ],
          "type": "string"
        },
        "kind": {
          "const": "approval",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/approval-mode"
        },
        "reason": {
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "decision"
      ],
      "type": "object"
    },
    "approval-subject": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "command",
            "file_write",
            "file_delete",
            "network",
            "tool",
            "other"
          ],
          "type": "string"
        },
        "detail": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "category",
        "summary"
      ],
      "type": "object"
    },
    "interaction-id": {
      "pattern": "^int_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "interaction-request": {
      "oneOf": [
        {
          "$ref": "#/$defs/question-request"
        },
        {
          "$ref": "#/$defs/approval-request"
        }
      ]
    },
    "interaction-response": {
      "oneOf": [
        {
          "$ref": "#/$defs/question-response"
        },
        {
          "$ref": "#/$defs/approval-response"
        }
      ]
    },
    "interaction-settlement": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/agent-error"
        },
        "outcome": {
          "$ref": "#/$defs/settlement-outcome"
        },
        "response": {
          "$ref": "#/$defs/interaction-response"
        },
        "settledAt": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "outcome",
        "settledAt"
      ],
      "type": "object"
    },
    "json-value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/json-value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "question-choice": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2000,
          "type": "string"
        },
        "label": {
          "maxLength": 400,
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "question-request": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/$defs/question-choice"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "kind": {
          "const": "question",
          "type": "string"
        },
        "multiSelect": {
          "default": false,
          "type": "boolean"
        },
        "placeholder": {
          "maxLength": 400,
          "type": "string"
        },
        "prompt": {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "prompt",
        "multiSelect"
      ],
      "type": "object"
    },
    "question-response": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "anyOf": [
            {
              "maxLength": 16000,
              "type": "string"
            },
            {
              "items": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1,
              "type": "array"
            }
          ]
        },
        "kind": {
          "const": "question",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "answer"
      ],
      "type": "object"
    },
    "run-id": {
      "pattern": "^run_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "run-state": {
      "enum": [
        "queued",
        "starting",
        "running",
        "awaiting_interaction",
        "interrupting",
        "succeeded",
        "failed",
        "interrupted"
      ],
      "type": "string"
    },
    "run-termination": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "error": {
          "$ref": "#/$defs/agent-error"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "interrupted"
          ],
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "at"
      ],
      "type": "object"
    },
    "sequence": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "session-id": {
      "pattern": "^ses_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "session-state": {
      "enum": [
        "opening",
        "ready",
        "closing",
        "closed",
        "failed"
      ],
      "type": "string"
    },
    "settlement-outcome": {
      "enum": [
        "responded",
        "cancelled",
        "expired",
        "withdrawn"
      ],
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "turn-id": {
      "pattern": "^trn_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "turn-input": {
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/turn-input-part"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "parts"
      ],
      "type": "object"
    },
    "turn-input-part": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "text": {
              "maxLength": 1000000,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "path": {
              "maxLength": 4096,
              "minLength": 1,
              "pattern": "^(?![\\\\/])(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$",
              "type": "string"
            },
            "type": {
              "const": "file_ref",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "turn-state": {
      "enum": [
        "accepted",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "inputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "totalTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "workspace-lease-descriptor": {
      "additionalProperties": false,
      "properties": {
        "acquiredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "leaseId": {
          "$ref": "#/$defs/workspace-lease-id"
        },
        "ownership": {
          "$ref": "#/$defs/workspace-ownership"
        },
        "released": {
          "default": false,
          "type": "boolean"
        },
        "root": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "leaseId",
        "ownership",
        "root",
        "acquiredAt",
        "released"
      ],
      "type": "object"
    },
    "workspace-lease-id": {
      "pattern": "^wsl_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "workspace-ownership": {
      "enum": [
        "borrowed",
        "managed"
      ],
      "type": "string"
    }
  },
  "$id": "https://schemas.relvo.dev/agent-runtime/0.4/session-snapshot.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "interactions": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "not": {
                "required": [
                  "settlement"
                ]
              }
            },
            "if": {
              "properties": {
                "status": {
                  "const": "settled"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "settlement"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "request": {
                  "properties": {
                    "kind": {
                      "const": "question"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "request"
              ]
            },
            "then": {
              "properties": {
                "settlement": {
                  "properties": {
                    "response": {
                      "properties": {
                        "kind": {
                          "const": "question"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "request": {
                  "properties": {
                    "kind": {
                      "const": "approval"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "request"
              ]
            },
            "then": {
              "properties": {
                "settlement": {
                  "properties": {
                    "response": {
                      "properties": {
                        "kind": {
                          "const": "approval"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              }
            }
          }
        ],
        "properties": {
          "expiresAt": {
            "$ref": "#/$defs/timestamp"
          },
          "interactionId": {
            "$ref": "#/$defs/interaction-id"
          },
          "request": {
            "$ref": "#/$defs/interaction-request"
          },
          "requestedAt": {
            "$ref": "#/$defs/timestamp"
          },
          "runId": {
            "$ref": "#/$defs/run-id"
          },
          "sessionId": {
            "$ref": "#/$defs/session-id"
          },
          "settlement": {
            "$ref": "#/$defs/interaction-settlement"
          },
          "status": {
            "enum": [
              "pending",
              "settled"
            ],
            "type": "string"
          },
          "turnId": {
            "$ref": "#/$defs/turn-id"
          }
        },
        "required": [
          "interactionId",
          "sessionId",
          "turnId",
          "runId",
          "status",
          "request",
          "requestedAt"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "runs": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "not": {
                "required": [
                  "termination"
                ]
              }
            },
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "succeeded",
                    "failed",
                    "interrupted"
                  ]
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "required": [
                "termination"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "succeeded"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "termination": {
                  "properties": {
                    "outcome": {
                      "const": "succeeded"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "failed"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "termination": {
                  "properties": {
                    "outcome": {
                      "const": "failed"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "interrupted"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "termination": {
                  "properties": {
                    "outcome": {
                      "const": "interrupted"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "awaiting_interaction"
                }
              },
              "required": [
                "state"
              ]
            },
            "then": {
              "properties": {
                "pendingInteractionIds": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          }
        ],
        "properties": {
          "attempt": {
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "pendingInteractionIds": {
            "default": [],
            "items": {
              "$ref": "#/$defs/interaction-id"
            },
            "type": "array"
          },
          "runId": {
            "$ref": "#/$defs/run-id"
          },
          "sessionId": {
            "$ref": "#/$defs/session-id"
          },
          "startedAt": {
            "$ref": "#/$defs/timestamp"
          },
          "state": {
            "$ref": "#/$defs/run-state"
          },
          "termination": {
            "$ref": "#/$defs/run-termination"
          },
          "turnId": {
            "$ref": "#/$defs/turn-id"
          },
          "usage": {
            "$ref": "#/$defs/usage"
          }
        },
        "required": [
          "runId",
          "sessionId",
          "turnId",
          "attempt",
          "state",
          "startedAt",
          "pendingInteractionIds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "session": {
      "additionalProperties": false,
      "properties": {
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "error": {
          "$ref": "#/$defs/agent-error"
        },
        "providerId": {
          "minLength": 1,
          "type": "string"
        },
        "sequence": {
          "$ref": "#/$defs/sequence"
        },
        "sessionId": {
          "$ref": "#/$defs/session-id"
        },
        "state": {
          "$ref": "#/$defs/session-state"
        },
        "turnIds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/turn-id"
          },
          "type": "array"
        },
        "wireVersion": {
          "const": "0.4",
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/workspace-lease-descriptor"
        }
      },
      "required": [
        "sessionId",
        "state",
        "providerId",
        "wireVersion",
        "workspace",
        "createdAt",
        "sequence",
        "turnIds"
      ],
      "type": "object"
    },
    "turns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "$ref": "#/$defs/timestamp"
          },
          "error": {
            "$ref": "#/$defs/agent-error"
          },
          "input": {
            "$ref": "#/$defs/turn-input"
          },
          "output": {
            "type": "string"
          },
          "runIds": {
            "default": [],
            "items": {
              "$ref": "#/$defs/run-id"
            },
            "type": "array"
          },
          "sessionId": {
            "$ref": "#/$defs/session-id"
          },
          "state": {
            "$ref": "#/$defs/turn-state"
          },
          "turnId": {
            "$ref": "#/$defs/turn-id"
          }
        },
        "required": [
          "turnId",
          "sessionId",
          "state",
          "input",
          "createdAt",
          "runIds"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "session",
    "turns",
    "runs",
    "interactions",
    "revision"
  ],
  "title": "session-snapshot",
  "type": "object",
  "x-wire-version": "0.4"
}
