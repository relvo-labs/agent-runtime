{
  "$defs": {
    "agent-error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/agent-error-code"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "providerCode": {
          "maxLength": 200,
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "type": "object"
    },
    "agent-error-code": {
      "enum": [
        "invalid_request",
        "unknown_session",
        "unknown_turn",
        "unknown_run",
        "unknown_interaction",
        "illegal_state_transition",
        "command_id_conflict",
        "session_closed",
        "run_already_terminal",
        "interaction_already_settled",
        "interaction_expired",
        "capability_unsupported",
        "workspace_unavailable",
        "workspace_ownership_violation",
        "provider_not_registered",
        "provider_rejected",
        "provider_unavailable",
        "provider_contract_violation",
        "store_conflict",
        "store_unavailable",
        "subscriber_overflow",
        "cursor_out_of_range",
        "internal"
      ],
      "type": "string"
    },
    "interaction-id": {
      "pattern": "^int_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "json-value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "items": {
            "$ref": "#/$defs/json-value"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/json-value"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    },
    "run-id": {
      "pattern": "^run_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "run-state": {
      "enum": [
        "queued",
        "starting",
        "running",
        "awaiting_interaction",
        "interrupting",
        "succeeded",
        "failed",
        "interrupted"
      ],
      "type": "string"
    },
    "run-termination": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "error": {
          "$ref": "#/$defs/agent-error"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "interrupted"
          ],
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "at"
      ],
      "type": "object"
    },
    "session-id": {
      "pattern": "^ses_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
    },
    "turn-id": {
      "pattern": "^trn_[0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{16,32}$",
      "type": "string"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "inputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "outputTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "totalTokens": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://schemas.relvo.dev/agent-runtime/0.4/agent-run.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "required": [
            "termination"
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "enum": [
              "succeeded",
              "failed",
              "interrupted"
            ]
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "termination"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "succeeded"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "termination": {
            "properties": {
              "outcome": {
                "const": "succeeded"
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "termination": {
            "properties": {
              "outcome": {
                "const": "failed"
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "interrupted"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "termination": {
            "properties": {
              "outcome": {
                "const": "interrupted"
              }
            },
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "awaiting_interaction"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "pendingInteractionIds": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ],
  "properties": {
    "attempt": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "pendingInteractionIds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/interaction-id"
      },
      "type": "array"
    },
    "runId": {
      "$ref": "#/$defs/run-id"
    },
    "sessionId": {
      "$ref": "#/$defs/session-id"
    },
    "startedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "state": {
      "$ref": "#/$defs/run-state"
    },
    "termination": {
      "$ref": "#/$defs/run-termination"
    },
    "turnId": {
      "$ref": "#/$defs/turn-id"
    },
    "usage": {
      "$ref": "#/$defs/usage"
    }
  },
  "required": [
    "runId",
    "sessionId",
    "turnId",
    "attempt",
    "state",
    "startedAt",
    "pendingInteractionIds"
  ],
  "title": "agent-run",
  "type": "object",
  "x-wire-version": "0.4"
}
