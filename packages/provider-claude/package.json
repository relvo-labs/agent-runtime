  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relvo-labs/agent-runtime.git",
    "directory": "packages/provider-claude"
  }
