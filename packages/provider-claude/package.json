{
  "name": "@relvo-labs/agent-provider-claude",
  "version": "0.1.0",
  "description": "Claude adapter for the neutral agent provider SPI, backed by the official Claude Agent SDK query surface.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@relvo-labs/agent-protocol": "workspace:^",
    "@relvo-labs/agent-provider": "workspace:^",
